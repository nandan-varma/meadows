module std.math;

extern "meadows_iabs" iabs(n: i32) -> i32;
extern "meadows_fabs" fabs(n: f64) -> f64;
extern "meadows_sqrt" sqrt(x: f64) -> f64;
extern "meadows_pow" pow(x: f64, y: f64) -> f64;
extern "meadows_sin" sin(x: f64) -> f64;
extern "meadows_cos" cos(x: f64) -> f64;
extern "meadows_tan" tan(x: f64) -> f64;
extern "meadows_asin" asin(x: f64) -> f64;
extern "meadows_acos" acos(x: f64) -> f64;
extern "meadows_atan" atan(x: f64) -> f64;
extern "meadows_atan2" atan2(y: f64, x: f64) -> f64;
extern "meadows_sinh" sinh(x: f64) -> f64;
extern "meadows_cosh" cosh(x: f64) -> f64;
extern "meadows_tanh" tanh(x: f64) -> f64;
extern "meadows_exp" exp(x: f64) -> f64;
extern "meadows_exp2" exp2(x: f64) -> f64;
extern "meadows_log" log(x: f64) -> f64;
extern "meadows_log10" log10(x: f64) -> f64;
extern "meadows_log2" log2(x: f64) -> f64;
extern "meadows_cbrt" cbrt(x: f64) -> f64;
extern "meadows_hypot" hypot(x: f64, y: f64) -> f64;
extern "meadows_floor" floor(x: f64) -> f64;
extern "meadows_ceil" ceil(x: f64) -> f64;
extern "meadows_round" round(x: f64) -> f64;
extern "meadows_trunc" trunc(x: f64) -> f64;
extern "meadows_min_i32" min_i32(a: i32, b: i32) -> i32;
extern "meadows_max_i32" max_i32(a: i32, b: i32) -> i32;
extern "meadows_rand" rand() -> i32;
extern "meadows_srand" srand(seed: i32) -> void;

extern "meadows_min_f64" min_f64(a: f64, b: f64) -> f64;
extern "meadows_max_f64" max_f64(a: f64, b: f64) -> f64;
extern "meadows_deg2rad" deg2rad(deg: f64) -> f64;
extern "meadows_rad2deg" rad2deg(rad: f64) -> f64;
extern "meadows_fmod" fmod(x: f64, y: f64) -> f64;
extern "meadows_isnan" isnan(x: f64) -> i32;
extern "meadows_isfinite" isfinite(x: f64) -> i32;
extern "meadows_isinf" isinf(x: f64) -> i32;
extern "meadows_fma" fma(x: f64, y: f64, z: f64) -> f64;
extern "meadows_ldexp" ldexp(mant: f64, exp: i32) -> f64;
extern "meadows_frexp" frexp(x: f64) -> f64;
extern "meadows_modf" modf(x: f64) -> f64;
extern "meadows_dtoi32" dtoi32(x: f64) -> i32;
extern "meadows_dtoi64" dtoi64(x: f64) -> i64;
extern "meadows_i32tod" i32tod(x: i32) -> f64;
extern "meadows_i64tod" i64tod(x: i64) -> f64;

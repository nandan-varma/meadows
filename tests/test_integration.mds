# Simplified Integration Test
# Test basic language features without complex recursion

def simple_function(x, y):
    """Simple function test"""
    result = x + y
    return result

# Simple class
class TestClass:
    def __init__(self, value):
        self.value = value
    
    def get_value(self):
        return self.value
    
    def double_value(self):
        self.value = self.value * 2
        return self.value

# Test basic operations
a = 10
b = 20
sum_result = simple_function(a, b)

# Test class instantiation
obj = TestClass(42)
original = obj.get_value()
doubled = obj.double_value()

# Test control flow
if sum_result > 25:
    status = "pass"
else:
    status = "fail"

print("Test completed with status:", status)

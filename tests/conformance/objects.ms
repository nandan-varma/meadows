let p = {name: "Ada", age: 36, tags: ["math", "code"]};
print(p.name);
print(p.age + 1);
print(p.tags[1]);
p.age = 37;
print(p.age);
print(p.age = 38);
let q = p;
q.name = "Grace";
print(p.name);
let nested = {inner: {deep: {value: 42}}};
print(nested.inner.deep.value);
nested.inner.deep.value = 43;
print(nested.inner.deep.value);
let people = [{n: "a", v: 1}, {n: "b", v: 2}];
print(people[1].n);
people[0].v = people[1].v + 10;
print(people[0].v);
let empty = {};
print(empty == {});
print({a: 1}.a);
print({a: 1} == {a: 1});
print(p == q);

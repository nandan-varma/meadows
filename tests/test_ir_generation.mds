# Simple IR Generation Tests

# Test 1: Basic function
def simple_add(x, y):
    return x + y

# Test 2: Simple control flow
def simple_if(x):
    if x > 0:
        return x
    else:
        return 0

# Test 3: Basic class
class SimpleClass:
    def __init__(self, value):
        self.value = value
    
    def get_value(self):
        return self.value

# Usage
result = simple_add(10, 20)
obj = SimpleClass(42)
val = obj.get_value()
conditional = simple_if(-5)
print("IR generation test completed")

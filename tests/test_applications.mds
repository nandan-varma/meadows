# Simple Application Examples

# Test 1: Basic calculator
class SimpleCalculator:
    def __init__(self):
        self.result = 0
    
    def add(self, a, b):
        self.result = a + b
        return self.result
    
    def subtract(self, a, b):
        self.result = a - b
        return self.result

# Test the calculator
calc = SimpleCalculator()
sum_result = calc.add(10, 5)
diff_result = calc.subtract(20, 8)

# Test 2: Simple data structure
class NumberList:
    def __init__(self):
        self.numbers = []
        self.count = 0
    
    def add_number(self, num):
        self.numbers.append(num)
        self.count = self.count + 1
    
    def get_total(self):
        total = 0
        i = 0
        while i < self.count:
            total = total + self.numbers[i]
            i = i + 1
        return total

# Test the number list
num_list = NumberList()
num_list.add_number(10)
num_list.add_number(20)
num_list.add_number(30)
total = num_list.get_total()

print("Calculator tests completed")
print("Sum result:", sum_result)
print("Difference result:", diff_result)
print("List total:", total)
